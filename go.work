go 1.25.0

use (
 .
 ./modules/recovery-core
 ./modules/recovery-evidence
 ./modules/qemu-discovery
 ./modules/vhost-linux
 ./apps/vhost-agent
 ./apps/vhost-faultlab
)

// Resolve the declared pre-release versions locally during workspace development.
// Release checks run with GOWORK=off against candidate module proxy archives.
replace (
 github.com/yckao/virtio-net-recovery/modules/recovery-core v0.1.0 => ./modules/recovery-core
 github.com/yckao/virtio-net-recovery/modules/recovery-evidence v0.1.0 => ./modules/recovery-evidence
 github.com/yckao/virtio-net-recovery/modules/qemu-discovery v0.1.0 => ./modules/qemu-discovery
 github.com/yckao/virtio-net-recovery/modules/vhost-linux v0.1.0 => ./modules/vhost-linux
)
